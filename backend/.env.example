# App
APP_NAME=karimi-auto-api
ENVIRONMENT=production
API_BASE_URL=https://api.karimiauto.site
FRONTEND_URL=https://karimiauto.site
CORS_ORIGINS=https://karimiauto.site,https://www.karimiauto.site,http://localhost:3000

# Database
DATABASE_URL=postgres://karimiauto:karimiauto@karimiauto_database:5432/karimiauto?sslmode=disable

# Google Sheets webhook (Apps Script deploy URL — no secret needed)
GOOGLE_SHEET_WEBHOOK_URL=

# Meta CAPI
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_API_VERSION=v20.0

# TikTok Events API
TIKTOK_PIXEL_CODE=
TIKTOK_ACCESS_TOKEN=

# Snapchat CAPI
SNAP_PIXEL_ID=
SNAP_ACCESS_TOKEN=

# Operations
ORDER_NUMBER_PREFIX=KARIMI
DEFAULT_CURRENCY=MAD
LOG_LEVEL=INFO

# MaxMind GeoIP / minFraud
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# Optional VPN/proxy fallback provider
IPQUALITYSCORE_API_KEY=

# Admin dashboard basic auth
ADMIN_USERNAME=
ADMIN_PASSWORD=
